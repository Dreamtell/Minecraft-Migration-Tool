# 仓库根目录的杂物。
# 项目本体在 Minecraft迁移工具/ 下，那边另有一份更细的 .gitignore。

# Python 缓存
__pycache__/
*.py[cod]

# 打包产物（auto-py-to-exe / PyInstaller 的输出）
/output/
build/
dist/
*.spec

# IDE
.idea/
.vscode/

# 系统杂项
*.log
Thumbs.db
desktop.ini

# 开发期兜底的 PySide6（解压出来的一份，205MB，别进仓库；正式用 pip install PySide6）
/_qt/

# Qt 试点窗口的截图与 demo 脚本（开发时看效果用的）
/_qt_demo.py
/_qt_*.png

# 本轮排查用的临时脚本与截图（真建界面、真发鼠标事件那批）
/_dctest/
# 早前图标/配色调试的产物（p_*.png 是打包图标候选的预览图，e2.txt 是空文件）
/_probe_shots/
/p_*.png
/e2.txt
/tools/diag_icon.py

# 手工备份（源码 zip / 旧包），不入库
/_backup/

# 仓库根的一次性发布包（181 MB，一次 git add -A 就会整个进库）
/*.zip

# Claude Code 的 worktree 目录：里面是整份仓库副本，会污染全局搜索，也不该入库
.claude/
