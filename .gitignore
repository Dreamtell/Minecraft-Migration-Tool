# 仓库根目录的杂物。
# 项目本体在 Minecraft迁移工具/ 下，那边另有一份更细的 .gitignore。

# Python 缓存
__pycache__/
*.py[cod]

# 打包产物（auto-py-to-exe / PyInstaller 的输出）
/output/
build/
dist/
*.spec

# IDE
.idea/
.vscode/

# 系统杂项
*.log
Thumbs.db
desktop.ini

# 开发期兜底的 PySide6（解压出来的一份，205MB，别进仓库；正式用 pip install PySide6）
/_qt/

# Qt 试点窗口的截图与 demo 脚本（开发时看效果用的）
/_qt_demo.py
/_qt_*.png

# 本轮排查用的临时脚本与截图（真建界面、真发鼠标事件那批）
/_dctest/
